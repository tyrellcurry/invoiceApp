# Production env file for the Pi. Copy to /opt/invoiceapp/.env and fill in
# real values; that file is never committed (bootstrap.sh creates it outside
# git, and bootstrap.sh itself never writes secrets into the repo checkout).

POSTGRES_USER=invoiceapp
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=invoiceapp
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# 8080 is pi-webserver and 8081 is pi-metrics (both already running on the
# Pi for tyrellcurry.io), so this app uses the next free port.
PORT=8082
# Verified by content, not just HTTP status: the page title and JS bundle
# filename here match the live deployment. Update both if the Vercel
# project's domain ever changes.
CORS_ALLOWED_ORIGIN=https://invoice-app-tyrell-curry.vercel.app

# From the existing Google OAuth client (Google Cloud Console > APIs &
# Services > Credentials); same client ID/secret as local dev.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://invoices-api.tyrellcurry.io/auth/google/callback

FRONTEND_URL=https://invoice-app-tyrell-curry.vercel.app
